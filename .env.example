# Database
MONGODB_URI=mongodb://localhost:27017/weedhub

# Sessions (min 32 chars — generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Cloudinary (strain image upload + CDN)
# https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend)
# https://resend.com/api-keys + https://resend.com/audiences
# Sender domain must be verified: contacto@weedhub.info
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# AI Moderation (Anthropic — Claude Haiku for strain-submission checks)
# Optional. If unset, submissions skip AI check and go straight to admin queue.
ANTHROPIC_API_KEY=

# Sentry (error tracking + performance monitoring)
# https://sentry.io → Settings → Projects → weedhub → Client Keys (DSN)
# SENTRY_DSN and VITE_SENTRY_DSN should be the same value
# SENTRY_AUTH_TOKEN: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# AI Image Generation (fal.ai by default)
# https://fal.ai/dashboard/keys — ~$0.003/image with Flux Schnell
# Set IMAGE_GEN_PROVIDER=replicate or IMAGE_GEN_PROVIDER=openai to switch providers.
IMAGE_GEN_API_KEY=
IMAGE_GEN_PROVIDER=fal

# Google OAuth (social login)
# https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://weedhub.info/auth/google/callback (+ http://localhost:5173 for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (B2B self-serve — brands & dispensaries)
# 1. Create 4 products in Stripe dashboard (test mode first)
# 2. Run locally: stripe listen --forward-to localhost:5173/api/stripe/webhook
# 3. Copy the whsec_... printed by stripe listen into STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRESENCIA_BRAND=price_...        # $49 USD/mes — Presencia Verificada (marcas)
STRIPE_PRICE_DESTACADO_BRAND=price_...        # $149 USD/mes — Destacado (marcas)
STRIPE_PRICE_PRESENCIA_DISPENSARIO=price_...  # $39 USD/mes — Presencia Verificada (dispensarios)
STRIPE_PRICE_DESTACADO_DISPENSARIO=price_...  # $99 USD/mes — Destacado (dispensarios)

# MCP endpoint (/mcp) for admin actions from Claude Desktop / EasyBits. Leave empty to disable.
ADMIN_MCP_TOKEN=
