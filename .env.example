MONGODB_URI=mongodb://localhost:27017/weedhub
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Newsletter (Resend Audiences)
# Create an audience at https://resend.com/audiences and copy both values.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Moderation (Anthropic — Claude Haiku for strain-submission checks)
# Optional. If unset, submissions skip the AI check and go straight to admin queue.
ANTHROPIC_API_KEY=

# Pexels (fallback images for strains without Midjourney images)
# Get key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# Stripe (B2B self-serve — brands & dispensaries)
# Create 4 products in Stripe dashboard (test mode first), copy price IDs.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRESENCIA_BRAND=price_...       # $49 USD/mes — Presencia Verificada (marcas)
STRIPE_PRICE_DESTACADO_BRAND=price_...       # $149 USD/mes — Destacado (marcas)
STRIPE_PRICE_PRESENCIA_DISPENSARIO=price_... # $39 USD/mes — Presencia Verificada (dispensarios)
STRIPE_PRICE_DESTACADO_DISPENSARIO=price_... # $99 USD/mes — Destacado (dispensarios)
